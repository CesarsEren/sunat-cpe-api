# =====================================================
# sunat-cpe-api — Variables de entorno (plantilla)
# =====================================================
# .env esta en .gitignore. NO subir valores reales.

# Ambiente SUNAT (false = Beta, true = Produccion)
SUNAT_PRODUCTION=false

# Timeouts SOAP (opcional, defaults razonables)
SUNAT_SOAP_CONNECT_TIMEOUT_MS=15000
SUNAT_SOAP_REQUEST_TIMEOUT_MS=60000
